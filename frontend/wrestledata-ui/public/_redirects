# Send the Netlify subdomain to the canonical host so crawlers don't index a duplicate copy.
# (matsavant.com -> www is already handled by Netlify's domain settings.)
https://matsavant.netlify.app/* https://www.matsavant.com/:splat 301!
http://matsavant.netlify.app/*  https://www.matsavant.com/:splat 301!

# The edge function source sits inside the publish dir (Netlify requires it under the base
# directory); don't serve it as a static file.
/netlify/*  /not-found  404!
