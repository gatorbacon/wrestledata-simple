  "rounds": {
   "2nd": "Bergman 2nd-place bout (wrestle-back survivor vs finals loser); winner is 2nd",
   "3rd": "bout for 3rd place (winner 3rd, loser 4th)",
   "Final": "championship final (winner 1st, loser 2nd in all drawn-consolation models)",
   "QF": "championship quarterfinal",
   "SF": "championship semifinal",
   "WB2_SF": "Bergman wrestle-back for 2nd, last stage before the 2nd-place bout"
  },
  "result_types": {
   "Dec": "decision; score = points, when printed",
   "Default": "win by default (injury etc.)",
   "Fall": "pin; score = time of fall (m:ss)",
   "MFF": "medical forfeit",
   "TA": "time-advantage decision (riding-time era); score = net advantage m:ss"
  },
  "result_type_suffix": {
   "-OT": "overtime of any kind: OT, sudden victory (SV), tiebreaker (TB) or criteria (Cr) - see result_raw"
  },
  "from": {
   "line:N": "came from draw line N (possibly advancing on byes, which are not rows)",
   "W:<match_id>": "won that bout",
   "L:<match_id>": "lost that bout"
  }
 },
